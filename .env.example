# Application Configuration
APP_NAME=HealthSetu
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL Async Engine)
# NOTE: Schema and production credentials are owned by the Database Team.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/healthsetu_dev

# Security & CORS
# Comma-separated list of allowed origins. Do not use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO

# API Routing
API_PREFIX=/api/v1

# Request Tracking
REQUEST_ID_HEADER=X-Request-ID

# Authentication & JWT Configuration (Phase 2)
# Generate a cryptographically secure random key in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change_this_to_a_secure_random_32_byte_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_HASHING_SCHEME=argon2id
AUTH_RATE_LIMIT_ENABLED=false
