# Application Configuration
APP_NAME=HealthSetu
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL Async Engine)
# NOTE: Schema and production credentials are owned by the Database Team.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/healthsetu_dev

# Security & CORS
# Comma-separated list of allowed origins. Do not use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO

# API Routing
API_PREFIX=/api/v1

# Request Tracking
REQUEST_ID_HEADER=X-Request-ID
