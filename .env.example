# Application Configuration
APP_NAME=HealthSetu
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL Async Engine)
# NOTE: Schema and production credentials are owned by the Database Team.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/healthsetu_dev

# Security & CORS
# Comma-separated list of allowed origins. Do not use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO

# API Routing
API_PREFIX=/api/v1

# Request Tracking
REQUEST_ID_HEADER=X-Request-ID

# Authentication & JWT Configuration (Phase 2)
# Generate a cryptographically secure random key in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change_this_to_a_secure_random_32_byte_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_HASHING_SCHEME=argon2id
AUTH_RATE_LIMIT_ENABLED=false

# Document Storage & Processing (Phase 5)
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_PATH=data/documents
OCR_PROVIDER=local
DOCUMENT_PROCESSING_ENABLED=true

# Medication & Terminology Provider (Phase 6)
MEDICATION_TERMINOLOGY_PROVIDER=local
MEDICATION_TERMINOLOGY_BASE_URL=
MEDICATION_TERMINOLOGY_API_KEY=
MEDICATION_TERMINOLOGY_TIMEOUT_SECONDS=10
MEDICATION_NORMALIZATION_ENABLED=true

# Medication Safety Provider (Phase 7 - High-Risk Component)
# Licensed commercial provider (FDB, DrugBank) or mock provider for dev/testing
MEDICATION_SAFETY_ENABLED=true
MEDICATION_SAFETY_PROVIDER=mock
MEDICATION_SAFETY_BASE_URL=
MEDICATION_SAFETY_API_KEY=
MEDICATION_SAFETY_TIMEOUT_SECONDS=15
MEDICATION_SAFETY_MAX_RETRIES=2
MEDICATION_SAFETY_RESULT_TTL_SECONDS=3600

# Triage & SBAR (Phase 8)
TRIAGE_ENABLED=true
TRIAGE_RULE_SET=healthsetu_emergency_triage_v1
TRIAGE_RULE_SET_VERSION=1.0.0
TRIAGE_RULE_ENGINE_TIMEOUT_SECONDS=5
SBAR_ENABLED=true
SBAR_GENERATION_MODE=template
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=15
AI_MAX_OUTPUT_TOKENS=1000

# Care Plan & Discharge (Phase 9)
CARE_PLAN_ENABLED=true
CARE_PLAN_DEFAULT_HORIZON_DAYS=30
DISCHARGE_EXTRACTION_PROVIDER=local
